# Configuración de MySQL que AtoM requiere; basada en upstream (docker/etc/mysql/mysqld.cnf).
# No modificar sin validar compatibilidad con AtoM.
[mysqld]
character-set-server=utf8mb4
collation-server=utf8mb4_0900_ai_ci
init_connect="SET collation_connection = utf8mb4_0900_ai_ci;SET NAMES utf8mb4"
# Respecto al sql_mode por defecto se omiten NO_ZERO_DATE, NO_ZERO_IN_DATE y ONLY_FULL_GROUP_BY.
sql_mode=STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
optimizer_switch='block_nested_loop=off'
