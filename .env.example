# Copia a .env para overrides locales (ignorado por Git). Ver README.md y docs/dev-runbook.md.

# Puerto web local
#ATOM_WEB_PORT=8080

# Administrador DEV.
# Solo aplican antes de la instalación inicial.
#ATOM_ADMIN_EMAIL=admin@example.com
#ATOM_ADMIN_USERNAME=admin
#ATOM_ADMIN_PASSWORD=admin_dev_12345

# Timezone compartido por PHP/Symfony
#ATOM_TIMEZONE=America/Bogota

# Título inicial del sitio
#ATOM_SITE_TITLE=Archivo Histórico (DEV)
